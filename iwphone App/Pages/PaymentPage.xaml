<Page x:Class="UIKitTutorials.Pages.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UIKitTutorials.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PaymentPage">
    <Page.Resources>
        <!-- Define a brush resource for the md style -->
        <SolidColorBrush x:Key="mdBrush" Color="#2196F3"/>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="0.7*"/>
            </Grid.RowDefinitions>

            <TextBlock Text=" 关于" FontSize="22" Foreground="#586A73" VerticalAlignment="Center"/>

            <!--<Border Grid.Row="0" Background="#EEEEEE"/>
            <Border Grid.Row="1" Background="#EEEEEE"/>-->
            <DockPanel Grid.Row="1" Margin="10">
                <!-- Use a DockPanel to separate the image and text controls -->
                <Border DockPanel.Dock="Left" Margin="10" Width="100" Height="100" CornerRadius="10">
                    <Border.Background>
                        <ImageBrush Stretch="Fill" ImageSource="ic_launcher-playstore.png" />
                    </Border.Background>
                </Border>

                <StackPanel DockPanel.Dock="Left" HorizontalAlignment="Left" Orientation="Vertical">
                    <TextBlock Text="" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" Foreground="#333333"/>
                    <TextBlock Text="软件名称: Iwphone" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" Foreground="#333333"/>
                    <TextBlock Text="软件版本: beta_1.0.0" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" Foreground="#333333"/>
                    <TextBlock Text="操作系统: windows" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" Foreground="#333333"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="2" Margin="10" MouseLeftButtonDown="yybutton">
                <!-- Use a Grid control to replace the UniformGrid control -->
                <Border Background="{DynamicResource mdBrush}" CornerRadius="10" Margin="10,10,-5,-5" RenderTransformOrigin="0.499,0.721"/>
                <StackPanel DockPanel.Dock="Left" HorizontalAlignment="Center" Orientation="Vertical">
                    <TextBlock Grid.Column="10" Grid.Row="10" Text="" FontSize="64" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Iwphone on Windows"  FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="开发环境：visual studio 2022 编程语言：C# NET框架版本：4.0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text=" 软件版本：beta_1.0.0 ADB Version：2.0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="  QQ群： 软件官网：" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text=" © haothirteen Iwphone" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text=" 鸣谢：Microsoft | Google | Github | Iwphone " FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="点击以跳转网页获取更多信息" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="https://github.com/haothtrteen/IWPhone" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>


        </Grid>



    </Border>
</Page>
