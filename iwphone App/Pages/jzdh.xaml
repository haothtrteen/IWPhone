<Window x:Class="iwphone.Pages.jzdh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iwphone.Pages"
        mc:Ignorable="d"
        Title="jzdh" Height="450" Width="800" Loaded="Window_Loaded"
         WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        ResizeMode="NoResize" WindowState="Normal">
    <!--<Grid>-->
    <Grid Margin="20">

        <!--<Image Source="bizhi.jpg"  Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="10" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>-->

        <Border CornerRadius="5">
            <Label Content="Loading..."  Foreground="{DynamicResource PrimaryBlueColor}" FontSize="40" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,132,0,0"/>
        </Border>

        <Rectangle Width="400" Height="14" Fill="LightGray"/>
        <Path Fill="#FF007ACC"  Width="400" Height="14">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Intersect">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,400,14"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry Rect="0,0,50,14">
                            <RectangleGeometry.Transform>
                                <TranslateTransform X="-50" x:Name="ProgressRectangle"/>
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
        <!--<Border x:Name="dhborder"  Background="Black" Height="30" Margin="285,202,305,203"/>
        <Button Content="开始动画" Height="30" Width="100" Margin="350,315,350,90" Click="Button_Click"/>-->
    </Grid>
</Window>
