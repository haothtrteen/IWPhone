<Page x:Class="iwphone.Pages.cjgl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:iwphone.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="cjgl">

    <Page.Resources>
        <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" CornerRadius="20">
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F3F6F9"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF3C7FB1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F3F6F9"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF2C628B"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F3F6F9"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF245A83"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#F3F6F9"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
                                <Setter Property="Foreground" Value="#FF838383"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid Margin="30 20 30 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Text=" 插件管理" FontSize="22" Foreground="#586A73" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Width="95" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2"  MouseLeftButtonDown="ymodbutton">
                    <TextBlock Text="浏览云端插件" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border Width="95" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                    <TextBlock Text="安装本地插件" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>


            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Width="150" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#FF245A83">
                    <TextBlock Text="查看本地已装插件" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>-->

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                        <TextBlock Text="《" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                        <TextBlock Text="》" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                        <TextBlock Text="返回第一页" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="1" Grid.Row="1">


                <Border Background="Transparent"  Visibility="{Binding Visibility}">
                    <Border Background="White" BorderThickness="0" CornerRadius="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!--#region Header-->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Name" Margin="15" FontWeight="SemiBold" Foreground="DarkSlateGray"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="File Item" FontWeight="SemiBold" Foreground="DarkSlateGray"/>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Uid" FontWeight="SemiBold" Foreground="DarkSlateGray"/>
                                <TextBlock Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Text="File Size" FontWeight="SemiBold" Foreground="DarkSlateGray"/>
                                <Separator Grid.ColumnSpan="5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" BorderThickness="1" BorderBrush="#F0F5F8"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False">
                                <StackPanel Orientation="Vertical">
                                    <Button Click="factoryfiles1" Style="{DynamicResource ButtonStyle1}" Height="80">
                                        <Button.Content>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                                                    <TextBlock Margin="5,0,0,0" x:Name="factoryfile1name" Text="这是一个bat插件 1" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"  x:Name="factoryfile1item" Text="简述插件作用" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="2" x:Name="factoryfile1uid" Text="2024.1.1" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="3" x:Name="factoryfile1size"  Text="15 Mb" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                    <Button Click="factoryfiles2" Style="{DynamicResource ButtonStyle1}" Height="80">
                                        <Button.Content>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                                                    <TextBlock Margin="5,0,0,0"  x:Name="factoryfile2name" Text="这是一个bat插件 2" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="factoryfile2item" Text="简述插件作用" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <!--<TextBlock Grid.Column="2" x:Name="factoryfile2uid"  Text="2024.1.2" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>-->
                                                <!--<TextBlock x:Name="factoryfile2size"   Text="45 Mb" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>-->
                                                <!-- 自定义开关样式 -->
                                                <StackPanel  Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                                    <!-- 开关按钮 -->
                                                    <ToggleButton x:Name="NightModeToggle" 
                          Content="模式" 
                          Width="80" Height="40" 
                          IsChecked="{Binding IsNightMode, Mode=TwoWay}" 
                          Checked="NightModeToggle_Checked" 
                          Unchecked="NightModeToggle_Unchecked">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="Gray" 
                                            BorderThickness="2" 
                                            CornerRadius="20" 
                                            Padding="5">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <!-- 选中状态：背景变蓝 -->
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter Property="Background" Value="#2E86C1"/>
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Trigger>
                                                                                <!-- 未选中状态：背景变灰 -->
                                                                                <Trigger Property="IsChecked" Value="False">
                                                                                    <Setter Property="Background" Value="#CCCCCC"/>
                                                                                    <Setter Property="Foreground" Value="Black"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                  
                                                </StackPanel>
                                                <!-- 状态显示 -->
                                                <Label  Grid.Column="2" x:Name="StatusLabel" Content="当前：日间模式" Margin="0,20,0,0" FontSize="14"/>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                    <Button Click="factoryfiles3" Style="{DynamicResource ButtonStyle1}" Height="80">
                                        <Button.Content>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                                                    <TextBlock Margin="5,0,0,0"  x:Name="factoryfile3name" Text="这是一个bat插件 3" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="factoryfile3item" Text="简述插件作用" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="2" x:Name="factoryfile3uid"  Text="2024.1.3" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="3"  x:Name="factoryfile3size"  Text="82 Mb" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                    <Button Click="factoryfiles4" Style="{DynamicResource ButtonStyle1}" Height="80">
                                        <Button.Content>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                                                    <TextBlock Margin="5,0,0,0"   x:Name="factoryfile4name" Text="这是一个shell插件 1" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="factoryfile4item" Text="简述插件作用" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="2" x:Name="factoryfile4uid"  Text="2024.1.4" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                                <TextBlock Grid.Column="3" x:Name="factoryfile4size"   Text="1 Mb" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                             

                                </StackPanel>
                            </ScrollViewer>
                            <!--#endregion-->
                        </Grid>
                    </Border>
                </Border>



            </UniformGrid>



        </Grid>


    </Border>
</Page>
