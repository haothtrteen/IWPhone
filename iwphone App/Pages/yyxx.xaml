<Window x:Class="iwphone.Pages.yyxx"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Title="APK App Manager" Height="450" Width="800" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        >
    <Window.Resources>
        
        
      </Window.Resources>
        <Grid>
        <Image x:Name="WallpaperImage" Source="bizhi.jpg"  Stretch="UniformToFill">
            <!--<Image.Effect>
                <BlurEffect Radius="10" KernelType="Gaussian"/>
            </Image.Effect>-->
        </Image>

        <Grid>

        <!--<Grid.Background>
            <ImageBrush ImageSource="YourImagePath.jpg"/>
        </Grid.Background>-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧滑栏 -->
            <Grid x:Name="Sidebar" Grid.Column="0" Width="350" Background="Transparent">
                <!-- 侧滑栏内容 -->
                <!-- 隐藏侧滑栏按钮 -->
               

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Border Grid.RowSpan="7" CornerRadius="25">
                    <Border.Background>
                        <LinearGradientBrush>
                            <GradientStop Color="#3253f1" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                </Border>
                <!-- Logo -->

                <Image Source="ic_launcher-playstore.png" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,10" />

                 <!--标题-->
                <TextBlock x:Name="title" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" Margin="0,10,0,10" />

                <!-- 功能图标和名称 -->
                <StackPanel Grid.Row="2" Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="/assets/document.png" Width="40" Height="40" Margin="10" />
                        <!--<TextBlock Text="功能1" VerticalAlignment="Center" />
                        <CheckBox Margin="10" />-->
                        <CheckBox Margin="0 40 0 20" FontSize="13"  x:Name="gnc1">
                            <TextBlock>
                                <Run Foreground="#b6b6b6">功能</Run>
                                <Run Foreground="#3253f1" x:Name="gn1"></Run>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="/assets/downloadsfolder.png" Width="40" Height="40" Margin="10" />
                        <CheckBox Margin="0 40 0 20" FontSize="13"   x:Name="gnc2">
                            <TextBlock>
                                <Run Foreground="#b6b6b6">功能</Run>
                                <Run Foreground="#3253f1" x:Name="gn2"></Run>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>

                <!-- 分割线 -->
                <Rectangle Grid.Row="3" Height="1" Fill="Gray" Margin="0,10" />

                <!-- 圆角按钮 -->
                <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,10">

                    <Button Width="120" Height="45" Margin="30" Background="#3253f1" Foreground="#05b790" FontSize="18"  Click="gnbutton" >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock  x:Name="zgn"/>
                        </StackPanel>
                    </Button>

                    <Button Width="120" Height="45" Margin="30" Background="#05b790" Foreground="#3253f1" FontSize="18"  Click="gbbutton" >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock  Text="取消"/>
                        </StackPanel>
                    </Button>

                    <!--<Button Content="功能" Background="#3253f1" Foreground="#ffffff" FontSize="18" Width="120" Height="45"  Margin="30" HorizontalAlignment="Center"  Click="gnbutton"  />
                    <Button Content="关闭" Background="#3253f1" Foreground="#ffffff" FontSize="18" Width="120" Height="45" Margin="10" HorizontalAlignment="Center" Click="gbbutton" />-->

                    <!--<Button Width="250" Height="40" Margin="15 30 15 0"  FontSize="16" HorizontalContentAlignment="Left"
                        Background="#3253f1" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe66e;" FontFamily="/#iconfont" FontSize="26" Foreground="#848484"/>
                            <TextBlock Text="Bing" Foreground="#848484" Margin="15 0 0 0"  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Width="250" Height="40" Margin="15 30 15 0"  FontSize="16" HorizontalContentAlignment="Left"
                        Background="#3253f1" BorderBrush="Transparent" Click="gbbutton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe518;" FontSize="26" FontFamily="/#iconfont" Foreground="#848484"/>
                            <TextBlock Text="关闭" Foreground="#848484" Margin="15 0 0 0"  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>-->
                   



                </StackPanel>

                <!-- 侧滑栏底部Logo -->
                <!--<Image Source="logo.png" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,20" />-->
            </Grid>

            <!-- 主内容区域 -->
            <Grid Grid.Column="1">




                <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top section -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <!--<Border CornerRadius="50" Background="White" Width="100" Height="100" Margin="0,0,10,0">
                   <Image Source="ic_launcher-playstore.png" Stretch="UniformToFill"/>
                </Border>-->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock  x:Name="appname" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Version Name: " FontSize="16"/>
                        <TextBlock  x:Name="versionnames" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Version Code: " FontSize="16"/>
                        <TextBlock  x:Name="versioncodes" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
        </Grid>

        <!-- Middle section -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock  Text="应用包名" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock  x:Name="packages" FontSize="14" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="安装路径" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="apkpaths" FontSize="14" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom section -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="White" CornerRadius="10" Padding="10">
                <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                            <TextBlock Text="高级功能" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                            <TextBlock Text="权限管理" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>-->
                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="yygl_Click">
                            <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                            <TextBlock Margin="5,0,0,0" Text="应用管理" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                            <TextBlock Grid.Column="1" Text="                                              利用adb进行卸载和其它安装功能" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>
                           
                        </StackPanel>

                            <StackPanel Orientation="Horizontal"  MouseLeftButtonDown="ztgl_Click">
                            <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/Video.png" HorizontalAlignment="Left"/>
                            <TextBlock Margin="5,0,0,0" Text="状态管理" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                            <TextBlock Grid.Column="1" Text="                                              利用adb管理应用状态应用，如冻结和解冻" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                        </StackPanel>

                            <StackPanel Orientation="Horizontal"  MouseLeftButtonDown="root_Click">
                            <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/document.png" HorizontalAlignment="Left"/>
                            <TextBlock Margin="5,0,0,0" Text="root提权" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                            <TextBlock Grid.Column="1" Text="                                              （测试性功能）" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                        </StackPanel>

                            <StackPanel Orientation="Horizontal"  MouseLeftButtonDown="gjgl_Click">
                            <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/downloadsfolder.png" HorizontalAlignment="Left"/>
                            <TextBlock Margin="5,0,0,0" Text="高级功能" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                            <TextBlock Grid.Column="1" Text="                                               爱玩机各类特色高级功能" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                        </StackPanel>

                          


                        </StackPanel>

                </Border>
        </Grid>

       
      
        
           <!-- Start: GridColumn Rigth -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <!-- Start: Button Close | Restore | Minimize -->
                <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Height="30" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button x:Name="btnClose" Style="{StaticResource IconButtonsStyle}" Content="{DynamicResource close}" Click="btnClose_Click" Tag="IsCloseButton"/>
                    <Button x:Name="btnRestore" Margin="5,0" Click="btnRestore_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonsStyle}">
                                <Setter Property="Content" Value="{DynamicResource maximize}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=home, Path=WindowState}" Value="Maximized">
                                        <Setter Property="Content" Value="{DynamicResource restore}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Click="btnMinimize_Click"/>
                </StackPanel>
                <!-- End: Button Close | Restore | Minimize -->
                
                
                <Border Grid.Row="1" Margin="10">
               
                    <Frame x:Name="PagesNavigation" NavigationUIVisibility="Hidden">
                        <!-- Page Content -->
                       
                    </Frame>

                </Border>
            </Grid>
            </Grid>

            <!-- 隐藏侧滑栏按钮 -->
           
        </Grid>
        
    </Grid>
</Window>