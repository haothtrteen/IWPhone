<Window x:Class="iwphone.Pages.cjxz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iwphone.Pages"
        mc:Ignorable="d"
        Title="cjxz" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="White" AllowsTransparency="True"
        ResizeMode="NoResize" WindowState="Normal">
    <Window.Resources>
        <Style x:Key="defaultRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#88949A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="border" Margin="20 0 20 0"/>
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#8CEDCB"/>
                                <Setter Property="BorderBrush" Value="#8CEDCB" TargetName="border"/>
                                <Setter Property="BorderThickness" Value="0 0 0 4" TargetName="border"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="BorderThickness" Value="0" TargetName="border"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Grid>


        <Grid Margin="30 10 30 10" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="插件" FontSize="22" Foreground="#596B75" Margin="10 0 0 0" VerticalAlignment="Center"/>

            <Border Background="{DynamicResource SecundaryBackgroundColor}" Grid.Row="1" CornerRadius="10" Margin="10 0 10 0">
                <Grid Grid.Column="1">




                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top section -->
                    <Grid Grid.Row="0" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--<Border CornerRadius="50" Background="White" Width="100" Height="100" Margin="0,0,10,0">
                   <Image Source="ic_launcher-playstore.png" Stretch="UniformToFill"/>
                </Border>-->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock  x:Name="appname" FontSize="20" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Version Name: " FontSize="16"/>
                                <TextBlock  x:Name="versionnames" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Version Size: " FontSize="16"/>
                                <TextBlock  x:Name="versioncodes" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Middle section -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock  Text="作者名称" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock  x:Name="packages" FontSize="14" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="下载链接" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="apkpaths" FontSize="14" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom section -->
                    <Grid Grid.Row="2" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="White" CornerRadius="10" Padding="10">
                            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                            <TextBlock Text="高级功能" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                            <TextBlock Text="权限管理" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>-->
                            <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="yygl_Click">
                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/folder.png" HorizontalAlignment="Left"/>
                                    <TextBlock Margin="5,0,0,0" Text="下载到本地" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                    <TextBlock Grid.Column="1" Text="                                              插件下载" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal"  MouseLeftButtonDown="ztgl_Click">
                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/Video.png" HorizontalAlignment="Left"/>
                                    <TextBlock Margin="5,0,0,0" Text="下载并安装" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                    <TextBlock Grid.Column="1" Text="                                              插件执行" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal"  MouseLeftButtonDown="root_Click">
                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/document.png" HorizontalAlignment="Left"/>
                                    <TextBlock Margin="5,0,0,0" Text="复制下载链接" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                    <TextBlock Grid.Column="1" Text="                                           使用三方浏览器自行下载" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                                </StackPanel>

                                <!--<StackPanel Orientation="Horizontal"  MouseLeftButtonDown="gjgl_Click">
                                    <Image Margin="5,0,0,0" Width="50" Stretch="Uniform" Source="/assets/downloadsfolder.png" HorizontalAlignment="Left"/>
                                    <TextBlock Margin="5,0,0,0" Text="高级功能" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" FontWeight="Bold" Foreground="LightSlateGray"/>
                                    <TextBlock Grid.Column="1" Text="                                               爱玩机各类特色高级功能" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="LightSlateGray"/>

                                </StackPanel>-->




                            </StackPanel>

                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Start: Button Close | Restore | Minimize -->
            <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Height="30" Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="btnClose" Style="{StaticResource IconButtonsStyle}" Content="{DynamicResource close}" Click="btnClose_Click" Tag="IsCloseButton"/>
                <Button x:Name="btnRestore" Margin="5,0" Click="btnRestore_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonsStyle}">
                            <Setter Property="Content" Value="{DynamicResource maximize}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=home, Path=WindowState}" Value="Maximized">
                                    <Setter Property="Content" Value="{DynamicResource restore}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="btnMinimize" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Click="btnMinimize_Click"/>
            </StackPanel>
            <!-- End: Button Close | Restore | Minimize -->


        </Grid>
    </Grid>
</Window>

