<Page x:Class="UIKitTutorials.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UIKitTutorials.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">
   
    
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid Margin="30 20 30 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="功能" FontSize="22" Foreground="#586A73" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--<Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                    <TextBlock Text="powered" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                    <TextBlock Text="by" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Width="80" Height="25" CornerRadius="10" BorderThickness="1" Margin="0 0 15 0" BorderBrush="#A4ADB2">
                    <TextBlock Text="thirteen" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
                <!--</Border>-->
            </StackPanel>

            <UniformGrid Columns="3" Grid.Row="1">
                <Grid>
                    <Border Background="#FF7000" Margin="50 20 50 20">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF7000" ShadowDepth="30" BlurRadius="50" Opacity="0.8" Direction="270"/>
                        </Border.Effect>
                    </Border>

                    <Border CornerRadius="10" Margin="10 0 10 0" Background="#FF7000">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border BorderThickness="1" Height="1" BorderBrush="#EBEBEB" VerticalAlignment="Center" Grid.RowSpan="2"/>

                            <Grid MouseLeftButtonDown="yyglbutton">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35"/>
                                <!--<TextBlock Text="&#xe521;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                <TextBlock Text="应用管理" Grid.Column="1" Foreground="White" FontSize="20" VerticalAlignment="Center"/>

                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" >
                                <Grid MouseLeftButtonDown="adbbutton">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35"/>
                                    <!--<TextBlock Text="&#xe521;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                    <TextBlock Text="adb命令行" Grid.Column="1" Foreground="White" FontSize="20" VerticalAlignment="Center"/>

                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>

                <Grid>
                    <Border Background="#FFC100" Margin="50 20 50 20">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFC100" ShadowDepth="30" BlurRadius="50" Opacity="0.8" Direction="270"/>
                        </Border.Effect>
                    </Border>

                    <Border CornerRadius="10" Margin="10 0 10 0" Background="#FFC100">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border BorderThickness="1" Height="1" BorderBrush="#EBEBEB" VerticalAlignment="Center" Grid.RowSpan="2"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35"/>
                                <!--<TextBlock Text="&#xe601;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                <TextBlock Text="激活工具" Grid.Column="1" Foreground="White" FontSize="20"  VerticalAlignment="Center"/>

                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" MouseLeftButtonDown="awhlbutton">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35"/>
                                    <!--<TextBlock Text="&#xe601;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                    <TextBlock Text="爱玩互联" Grid.Column="1" Foreground="White" FontSize="20" VerticalAlignment="Center"/>

                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>

                <Grid>
                    <Border Background="#59E6B5" Margin="50 20 50 20">
                        <Border.Effect>
                            <DropShadowEffect Color="#59E6B5" ShadowDepth="30" BlurRadius="50" Opacity="0.8" Direction="270"/>
                        </Border.Effect>
                    </Border>

                    <Border CornerRadius="10" Margin="10 0 10 0" Background="#59E6B5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border BorderThickness="1" Height="1" BorderBrush="#EBEBEB" VerticalAlignment="Center" Grid.RowSpan="2"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35"/>
                                <!--<TextBlock Text="&#xe69d;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                <TextBlock Text="高级功能" Grid.Column="1" Foreground="White" FontSize="20" VerticalAlignment="Center"/>

                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center"  MouseLeftButtonDown="glqdbutton">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#ffffff" Opacity="0.2" Width="35" Height="35" CornerRadius="35" />
                                    <!--<TextBlock Text="&#xe69d;" FontFamily="Fonts/#iconfont" 
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>-->

                                    <TextBlock Text="安装驱动" Grid.Column="1" Foreground="White" FontSize="20" VerticalAlignment="Center"/>

                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>
            </UniformGrid>




        </Grid>

      
    </Border>
</Page>
