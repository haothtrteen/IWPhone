<Window x:Class="iwphone.Pages.push"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIKitTutorials.Pages"
        mc:Ignorable="d"
        Title="push" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="White" AllowsTransparency="True"
        ResizeMode="NoResize" WindowState="Normal">
    <Window.Resources>
        <Style x:Key="defaultRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#88949A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="border" Margin="20 0 20 0"/>
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#8CEDCB"/>
                                <Setter Property="BorderBrush" Value="#8CEDCB" TargetName="border"/>
                                <Setter Property="BorderThickness" Value="0 0 0 4" TargetName="border"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="BorderThickness" Value="0" TargetName="border"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Grid>
       
       
        <Grid Margin="30 10 30 10" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="ADB Push" FontSize="22" Foreground="#596B75" Margin="10 0 0 0" VerticalAlignment="Center"/>

            <Border Background="White" Grid.Row="1" CornerRadius="10" Margin="10 0 10 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="DarkGray" Opacity="0.4" Direction="280" ShadowDepth="0" />
                </Border.Effect>
                <Grid>

                   
                    <UniformGrid Columns="2" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="15 0 0 0" >
                            <TextBlock Text="🔍" FontSize="18" Foreground="#959595" VerticalAlignment="Center"/>
                            <!--<TextBlock Text="Search Project" Foreground="#959595" VerticalAlignment="Center" Margin="10 0 0 0" FontSize="15"/>-->
                            <Border Width="300" Height="30" BorderThickness="1"  BorderBrush="#959595" CornerRadius="5" Margin="10 0 10 0">
                                <TextBox x:Name="pushwj" Text="请输入要推送的文件"  Foreground="#959595" Grid.Row="0" Grid.Column="1" Margin="2"/>
                            </Border>
                           
                        </StackPanel>

                       

                        <RadioButton Style="{StaticResource defaultRadioStyle}" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="18" FontFamily="Fonts/#iconfont" VerticalAlignment="Center"/>
                                <TextBlock Text="读取文件" Margin="10 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>


                        <StackPanel Orientation="Horizontal" Margin="15 0 0 0" >
                            <TextBlock Text="🔍" FontSize="18" Foreground="#959595" VerticalAlignment="Center"/>
                            <!--<TextBlock Text="Search Project" Foreground="#959595" VerticalAlignment="Center" Margin="10 0 0 0" FontSize="15"/>-->
                            <Border Width="300" Height="30" BorderThickness="1"  BorderBrush="#959595" CornerRadius="5" Margin="10 0 10 0">
                                <TextBox x:Name="pushwj1" Text="请输入要推送的目录（可选）"  Foreground="#959595" Grid.Row="0" Grid.Column="1" Margin="2"/>
                            </Border>

                        </StackPanel>

                        <RadioButton Style="{StaticResource defaultRadioStyle}" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontSize="18" FontFamily="Fonts/#iconfont" VerticalAlignment="Center"/>
                                <TextBlock Text="开始传输" Margin="10 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </UniformGrid>




                </Grid>
            </Border>
        </Grid>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Start: Button Close | Restore | Minimize -->
            <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Height="30" Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="btnClose" Style="{StaticResource IconButtonsStyle}" Content="{DynamicResource close}" Click="btnClose_Click" Tag="IsCloseButton"/>
                <Button x:Name="btnRestore" Margin="5,0" Click="btnRestore_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonsStyle}">
                            <Setter Property="Content" Value="{DynamicResource maximize}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=home, Path=WindowState}" Value="Maximized">
                                    <Setter Property="Content" Value="{DynamicResource restore}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="btnMinimize" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Click="btnMinimize_Click"/>
            </StackPanel>
            <!-- End: Button Close | Restore | Minimize -->


        </Grid>
    </Grid>
</Window>
